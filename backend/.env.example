# =====================================================
# Signature City — Backend environment template
# Copy to backend/.env and fill real values. Never commit .env.
# =====================================================

# MongoDB connection string. Provide your real URI (MongoDB Atlas / local mongod).
# Local example: mongodb://127.0.0.1:27017/signature_city
MONGODB_URI=

# Port the Express server listens on.
PORT=3001

# Allowed frontend origin(s) for CORS. Comma-separate multiple origins.
FRONTEND_URL=http://localhost:5173

# Secret used to sign admin JWT tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Optional admin bootstrap (used by the seed script to create the first admin
# user for /auth/login). Leave empty to skip user seeding.
ADMIN_EMAIL=
ADMIN_PASSWORD=