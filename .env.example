# =====================================================
# Signature City — Environment template
# Copy to .env and fill real values. Never commit .env.
# =====================================================

# Base URL of the Xano backend (Phase 5).
# When empty, the app uses the built-in static content layer.
VITE_API_URL=

# Xano admin auth group (api:admin). Used for POST /auth/login and GET /auth/me.
# When empty, admin sign-in is disabled and the guard redirects to /admin/login.
VITE_AUTH_API_URL=

# Cloudinary cloud name (images). Optional while using placeholders.
VITE_CLOUDINARY_CLOUD_NAME=

# Analytics / monitoring (optional)
VITE_SENTRY_DSN=
